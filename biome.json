{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["**", "!server/dist", "!server/generated", "!node_modules", "!.claude"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["server/test/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noTemplateCurlyInString": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
