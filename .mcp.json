{
  "mcpServers": {
    "gorelo": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/dist/index.js"],
      "env": {
        "GORELO_API_KEY": "${user_config.api_key}",
        "GORELO_REGION": "${user_config.region}",
        "GORELO_ACCESS_TIER": "${user_config.access_tier}",
        "GORELO_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
